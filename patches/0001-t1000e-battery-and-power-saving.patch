+  // reason we are going down for.
+#ifdef BUTTON_PIN
+  nrf_gpio_cfg_sense_input(BUTTON_PIN, NRF_GPIO_PIN_NOPULL, NRF_GPIO_PIN_SENSE_HIGH);
+#endif
