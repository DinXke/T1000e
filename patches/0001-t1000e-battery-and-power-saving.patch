+/*
+  Low-battery warning and protective shutdown.
+
+  Without this, a T1000-E on a flat cell simply browns out: no warning, no tune,
+  and a flash write in progress at that moment can take the filesystem with it.
+  The stock ui-orig had no battery watchdog at all -- AUTO_SHUTDOWN_MILLIVOLTS
+  was only ever honoured by ui-tiny and ui-new, neither of which this board
+  builds.
+*/
+void UITask::batteryWatchdog() {
+#if defined(AUTO_SHUTDOWN_MILLIVOLTS) || defined(LOW_BATT_WARN_MILLIVOLTS)
+  unsigned long now = millis();
+  // Signed difference, so the watchdog survives the millis() wrap at ~49 days
+  // rather than going quiet for the rest of the device's uptime.
+  if ((long)(now - _next_batt_watch) < 0) return;
+  _next_batt_watch = now + BATT_WATCH_MILLIS;
+
+#ifdef LOW_BATT_WARN_MILLIVOLTS
+  const uint16_t warn_mv = LOW_BATT_WARN_MILLIVOLTS;
+#else
+  const uint16_t warn_mv = 0;
+#endif
+#ifdef AUTO_SHUTDOWN_MILLIVOLTS
+  const uint16_t stop_mv = AUTO_SHUTDOWN_MILLIVOLTS;
+#else
+  const uint16_t stop_mv = 0;
+#endif
+
+  uint16_t mv = _board->getBattMilliVolts();
+
+  batt_watch_state_t st;
+  st.low_streak = _batt_low_streak;
+  st.warned = _low_batt_warned ? 1 : 0;
+
+  batt_action_t action = battery_watch_step(&st, mv, _board->isExternalPowered() ? 1 : 0,
+                                            warn_mv, stop_mv, AUTO_SHUTDOWN_READINGS);
+
+  _batt_low_streak = st.low_streak;
+  _low_batt_warned = (st.warned != 0);
+
+  if (action == BATT_ACTION_WARN) {
+    sprintf(_alert, "Battery low: %u%%", (unsigned) battery_percent_from_mv(mv));
+    _need_refresh = true;
+  #ifdef PIN_BUZZER
+    buzzer.play(LOW_BATT_SONG);
+  #endif
+    MESH_DEBUG_PRINTLN("UITask: low battery warning at %u mV", (unsigned) mv);
+  } else if (action == BATT_ACTION_SHUTDOWN) {
+    MESH_DEBUG_PRINTLN("UITask: battery critical (%u mV) - shutting down", (unsigned) mv);
+    sprintf(_alert, "Battery empty");
+    if (_display != NULL && _display->isOn()) {
+      _display->startFrame();
+      renderCurrScreen();
+      _display->endFrame();
+    }
+    shutdown();   // plays the shutdown tune, then powers the board off
+  }
+#endif
+}
+
 void UITask::loop() {
+  batteryWatchdog();
+
   #ifdef PIN_USER_BTN
     if (_userButton) {
       _userButton->update();
