+; ---------------------------------------------------------------------------
+; T1000-E companion radio (BLE) with battery-curve reporting and power saving.
+;
+; Same as t1000e_companion_radio_ble, plus:
+;   * LiPo discharge curve instead of a linear 3.0-4.2V map (BatteryCurve)
+;   * a low-battery warning and a protective shutdown, neither of which the
+;     stock ui-orig build had at all
+;   * nRF52 boot-voltage protection and shutdown-reason tracking
+;   * slower BLE advertising, and idle connection parameters while an app is
+;     connected but quiet
+;
+; The stock env above is left untouched, so both can be built and compared.
+; ---------------------------------------------------------------------------
+[env:t1000e_companion_radio_ble_ps]
+extends = t1000-e
+board_build.ldscript = boards/nrf52840_s140_v7_extrafs.ld
+board_upload.maximum_size = 708608
+build_flags = ${t1000-e.build_flags}
+  -I examples/companion_radio/ui-orig
+  -D MAX_CONTACTS=350
+  -D MAX_GROUP_CHANNELS=40
+  -D BLE_PIN_CODE=123456
+  -D BLE_TX_POWER=0
+;  -D BLE_DEBUG_LOGGING=1
+;  -D MESH_PACKET_LOGGING=1
+;  -D MESH_DEBUG=1
+  -D OFFLINE_QUEUE_SIZE=256
+  -D DISPLAY_CLASS=NullDisplayDriver
+  -D PIN_BUZZER=25
+  -D PIN_BUZZER_EN=37      ; P1/5 - required for T1000-E
+  -D ADVERT_NAME='"@@MAC"'
+  ; --- battery ------------------------------------------------------------
+  ; A T1000-E has been observed still running normally at 3250mV, so the
+  ; shutdown threshold sits below that rather than at the 3400 other boards
+  ; use -- cutting a working device off early is its own bug. Read
+  ; docs/battery.md before changing these two, and calibrate first.
+  -D AUTO_SHUTDOWN_MILLIVOLTS=3200   ; power down before the brownout
+  -D LOW_BATT_WARN_MILLIVOLTS=3400   ; warn only, no action
+  -D BATTERY_USE_CURVE=1             ; LiPo curve instead of the linear map
+  -D BATTERY_PERCENT_SPOOF=1         ; make unmodified apps show the real %
+  -D BATTERY_TELEMETRY_SPOOF=1       ; ...including the app's telemetry page
+  -D BATTERY_EXT_FRAME=1             ; also send true % and true mV
+; -D BATT_CURVE_OFFSET_MV=0          ; per-unit calibration, see docs/battery.md
+  ; --- power saving --------------------------------------------------------
+  -D NRF52_POWER_MANAGEMENT
+  -D BLE_POWER_SAVING=1
+build_src_filter = ${t1000-e.build_src_filter}
+  +<helpers/nrf52/SerialBLEInterface.cpp>
+  +<helpers/ui/buzzer.cpp>
+  +<helpers/ui/NullDisplayDriver.cpp>
+  +<../examples/companion_radio/*.cpp>
+  +<../examples/companion_radio/ui-orig/*.cpp>
+lib_deps = ${t1000-e.lib_deps}
+  densaugeo/base64 @ ~1.4.0
+  stevemarple/MicroNMEA @ ^2.0.6
+  end2endzone/NonBlockingRTTTL@^1.3.0
+
 [env:t1000e_kiss_modem]
 extends = t1000-e
 build_src_filter = ${t1000-e.build_src_filter}
