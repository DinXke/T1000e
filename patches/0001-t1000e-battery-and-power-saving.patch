+/* ---------------------------------------------------------------------------
+   BLE power saving (opt-in per variant with -D BLE_POWER_SAVING=1)
+
+   Two changes, both of which only affect the radio's duty cycle:
+
+   1. Slow advertising. Stock advertises at 20ms for the first 30 seconds and
+      then at 152.5ms forever. A companion node spends most of its life
+      disconnected and advertising, so that steady-state rate is what actually
+      drains the cell. Dropping it to one advertisement per second cuts the
+      advertising duty cycle by roughly 6x. Discovery still starts at 20ms for
+      the first 30 seconds after boot and after every disconnect, so pairing
+      and reconnecting feel the same.
+
+   2. Idle connection parameters. While an app is connected but nothing is
+      being exchanged, renegotiate to a longer connection interval with slave
+      latency, and go back to the fast parameters the moment a frame moves in
+      either direction. Costs up to about a second of extra latency on the
+      first frame after an idle period; saves the radio waking every 30ms to
+      exchange empty packets for as long as the app stays connected.
+   --------------------------------------------------------------------------- */
+#ifndef BLE_POWER_SAVING
+  #define BLE_POWER_SAVING 0
+#endif
+
+#if BLE_POWER_SAVING
+  #ifndef BLE_ADV_INTERVAL_SLOW
+    #define BLE_ADV_INTERVAL_SLOW    1600   // 1000ms (units: 0.625ms)
+  #endif
+  // Quiet time before the connection is downshifted.
+  #ifndef BLE_IDLE_MILLIS
+    #define BLE_IDLE_MILLIS          20000
+  #endif
+  // Idle connection parameters (interval units 1.25ms, timeout units 10ms).
+  // Supervision timeout must exceed (1 + latency) * max_interval * 2:
+  // (1 + 4) * 200ms * 2 = 2000ms, comfortably inside the 6000ms below.
+  #ifndef BLE_IDLE_MIN_CONN_INTERVAL
+    #define BLE_IDLE_MIN_CONN_INTERVAL   80    // 100ms
+  #endif
+  #ifndef BLE_IDLE_MAX_CONN_INTERVAL
+    #define BLE_IDLE_MAX_CONN_INTERVAL   160   // 200ms
+  #endif
+  #ifndef BLE_IDLE_SLAVE_LATENCY
+    #define BLE_IDLE_SLAVE_LATENCY       4
+  #endif
+  #ifndef BLE_IDLE_CONN_SUP_TIMEOUT
+    #define BLE_IDLE_CONN_SUP_TIMEOUT    600   // 6000ms
+  #endif
+  // The SoftDevice will not accept back-to-back parameter updates; keep a
