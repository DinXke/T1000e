+// ---- nRF52 power management (see docs/nrf52_power_management.md) ----------
+// Below this voltage the device refuses to boot and goes straight back to
+// SYSTEMOFF, so a flat cell cannot boot-loop itself into a brownout during a
+// flash write. Matches AUTO_SHUTDOWN_MILLIVOLTS so the two thresholds agree.
+#ifndef PWRMGT_VOLTAGE_BOOTLOCK
+  #define PWRMGT_VOLTAGE_BOOTLOCK 3400   // mV
+#endif
+
+// LPCOMP wake channel: BATTERY_PIN is P0.02 = AIN0.
+#define PWRMGT_LPCOMP_AIN       0
+// REFSEL 8 = 9/16 VDD. With ADC_MULTIPLIER 2.0 the pin sees Vbat/2, so this
+// trips at roughly Vbat 3.7V.
+#define PWRMGT_LPCOMP_REFSEL    8
+
+// LPCOMP voltage wake is OFF by default on this board. The battery divider
+// sits behind the switched sensor rail (PIN_3V3_EN), so it is not established
+// that AIN0 carries a usable voltage while the device is in SYSTEMOFF with
+// that rail down. VBUS (USB) wake is unaffected and always active, which is
+// the recovery path that matters: plugging the charger in wakes the device.
